# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/aec_network"

# --- Auth.js (NextAuth) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"

# --- Email (transactional: enrollment confirmations, fee reminders, etc.) ---
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="no-reply@example.com"

# --- Payments (placeholder — wire to your actual gateway) ---
PAYMENT_PROVIDER_KEY=""
PAYMENT_PROVIDER_SECRET=""

# --- WhatsApp / Messaging (placeholder) ---
WHATSAPP_API_TOKEN=""

# --- Online Class meeting platforms (placeholder — set only what you use) ---
ZOOM_API_KEY=""
ZOOM_API_SECRET=""
GOOGLE_MEET_CLIENT_ID=""
GOOGLE_MEET_CLIENT_SECRET=""
TEAMS_CLIENT_ID=""
TEAMS_CLIENT_SECRET=""

# --- Organization info (PLACEHOLDER — replace with verified AEC details only) ---
NEXT_PUBLIC_ORG_NAME="AEC Network"
NEXT_PUBLIC_ORG_EMAIL="info@example.com"
NEXT_PUBLIC_ORG_PHONE=""
NEXT_PUBLIC_ORG_ADDRESS=""
